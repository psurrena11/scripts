#!/bin/bash

if [ $# -eq 0 ]; then
    echo "========================"
    echo "   Graphics Mode Switch"
    echo "========================"
    echo ""
    echo "  1) Integrated"
    echo "  2) Dedicated"
    echo "  3) Hybrid"
    echo "  4) Cancel"
    echo ""
    echo "------------------------"
    read -p "Choose mode [1-4]: " choice
    case $choice in
        1) set -- "-i" ;;
        2) set -- "-d" ;;
        3) set -- "-h" ;;
        4)
            echo "Cancelled."
            exit 0
            ;;
        *)
            echo "Invalid choice."
            exit 1
            ;;
    esac
fi


case "$1" in
	-i)
			echo "Switching to Integrated mode..."
			supergfxctl -m Integrated
			;;
	-d)
			echo "Switching to Dedicated mode..."
			supergfxctl -m Dedicated
			;;
	-h)
			echo "Switching to Hybrid mode..."
			supergfxctl -m Hybrid
			;;
	*) 
			echo "Invalid option: $1"
			echo "Use [ -i | -d | -h ]"
			exit 1
			;;
esac
